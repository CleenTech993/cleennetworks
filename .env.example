# Public platform support number, international digits only (example: 2547XXXXXXXX).
VITE_PLATFORM_SUPPORT_WHATSAPP=

# Canonical application hostname used as the CNAME target for tenant custom domains.
# Keep both values aligned; VITE_* is embedded at build time.
APP_CANONICAL_HOST=app.example.com
VITE_APP_CANONICAL_HOST=app.example.com